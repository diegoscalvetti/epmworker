---
// Illustrative hero: a site under construction, workers with wearables,
// signals flowing to a dashboard the worker can see, and a shield for data rights (HDI).
interface Props { lang: 'es' | 'en' }
const { lang } = Astro.props;
const L = lang === 'es'
  ? { prod: 'Productividad', health: 'Salud', safety: 'Seguridad', mine: 'Mis datos', aria: 'Ilustración: trabajadores con sensores en una obra y un panel de datos compartido con ellos' }
  : { prod: 'Productivity', health: 'Health', safety: 'Safety', mine: 'My data', aria: 'Illustration: workers wearing sensors on a construction site and a data dashboard shared with them' };
---
<svg class="hero-art" viewBox="0 0 520 440" role="img" aria-label={L.aria}>
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="var(--art-sky1)" />
      <stop offset="1" stop-color="var(--art-sky2)" />
    </linearGradient>
  </defs>
  <rect x="0" y="0" width="520" height="440" rx="28" fill="url(#sky)" />
  <!-- Andes -->
  <path d="M0 300 L70 230 L110 260 L175 190 L230 250 L290 205 L360 265 L420 215 L520 290 L520 440 L0 440 Z" fill="var(--art-mount)" />
  <path d="M160 205 L175 190 L190 206 L182 202 L175 210 L168 203 Z M282 213 L290 205 L299 214 L290 211 Z M410 224 L420 215 L431 226 L421 222 Z" fill="var(--art-snow)" />
  <rect x="0" y="330" width="520" height="110" fill="var(--art-ground)" />

  <!-- crane -->
  <g stroke="var(--art-steel)" stroke-width="4" fill="none">
    <path d="M110 330 V95 M126 330 V95 M110 95 H126" />
    <path d="M110 120 L126 140 L110 160 L126 180 L110 200 L126 220 L110 240 L126 260 L110 280 L126 300 L110 320" stroke-width="2" />
    <path d="M60 95 H330 M60 95 L118 70 L330 95" stroke-width="3" />
  </g>
  <rect x="44" y="92" width="26" height="18" fill="var(--art-steel)" />
  <line x1="290" y1="95" x2="290" y2="165" stroke="var(--art-steel)" stroke-width="1.5" />
  <rect x="270" y="165" width="40" height="10" rx="2" fill="#d9480f" />

  <!-- building frame -->
  <g fill="none" stroke="var(--art-frame)" stroke-width="5">
    <rect x="170" y="200" width="160" height="130" />
    <path d="M170 243 H330 M170 287 H330 M223 200 V330 M277 200 V330" stroke-width="3" />
  </g>
  <rect x="170" y="287" width="53" height="43" fill="var(--art-panel)" opacity="0.9" />
  <rect x="223" y="243" width="54" height="44" fill="var(--art-panel)" opacity="0.6" />

  <!-- signals -->
  <g fill="none" stroke="#d9480f" stroke-width="2.5" stroke-linecap="round" class="waves">
    <path d="M366 268 q12 -12 0 -24" /><path d="M374 274 q22 -18 0 -36" />
    <path d="M196 340 q-8 -14 4 -26" opacity="0.7" />
  </g>

  <!-- worker 1 -->
  <g transform="translate(350 300)">
    <ellipse cx="0" cy="62" rx="24" ry="5" fill="#000" opacity="0.12" />
    <rect x="-14" y="10" width="28" height="34" rx="6" fill="#f4a300" />
    <path d="M-14 22 H14 M-14 30 H14" stroke="#fff" stroke-width="3" />
    <rect x="-12" y="44" width="10" height="18" fill="var(--art-jeans)" /><rect x="2" y="44" width="10" height="18" fill="var(--art-jeans)" />
    <circle cx="0" cy="-2" r="11" fill="#c98e6b" />
    <path d="M-14 -4 Q0 -24 14 -4 Z" fill="#ffffff" stroke="var(--art-steel)" stroke-width="1" />
    <path d="M14 18 L26 32" stroke="#f4a300" stroke-width="7" stroke-linecap="round" />
    <rect x="21" y="27" width="9" height="7" rx="2" fill="#d9480f" />
    <path d="M-14 18 L-22 34" stroke="#f4a300" stroke-width="7" stroke-linecap="round" />
  </g>
  <!-- worker 2 -->
  <g transform="translate(200 352)">
    <ellipse cx="0" cy="40" rx="18" ry="4" fill="#000" opacity="0.12" />
    <rect x="-11" y="4" width="22" height="24" rx="5" fill="#f4a300" />
    <rect x="-9" y="28" width="8" height="12" fill="var(--art-jeans)" /><rect x="1" y="28" width="8" height="12" fill="var(--art-jeans)" />
    <circle cx="0" cy="-5" r="8.5" fill="#8d5a3b" />
    <path d="M-11 -6 Q0 -21 11 -6 Z" fill="#2b6cd4" />
    <rect x="-4" y="10" width="8" height="6" rx="1.5" fill="#d9480f" />
  </g>

  <!-- dashboard card -->
  <g transform="translate(372 46)">
    <rect width="130" height="190" rx="14" fill="var(--surface)" stroke="var(--line)" />
    <text x="14" y="26" class="art-h">EPM</text>
    <circle cx="112" cy="21" r="5" fill="#15a38a" />
    <text x="14" y="52" class="art-s">{L.prod}</text>
    <rect x="14" y="58" width="102" height="7" rx="3.5" fill="var(--line)" /><rect x="14" y="58" width="78" height="7" rx="3.5" fill="#2b6cd4" />
    <text x="14" y="84" class="art-s">{L.health}</text>
    <rect x="14" y="90" width="102" height="7" rx="3.5" fill="var(--line)" /><rect x="14" y="90" width="60" height="7" rx="3.5" fill="#15a38a" />
    <text x="14" y="116" class="art-s">{L.safety}</text>
    <rect x="14" y="122" width="102" height="7" rx="3.5" fill="var(--line)" /><rect x="14" y="122" width="92" height="7" rx="3.5" fill="#e07b22" />
    <g transform="translate(14 142)">
      <rect width="102" height="34" rx="10" fill="var(--accent-soft)" />
      <path d="M17 7 L27 11 V18 C27 24 22 27 17 29 C12 27 7 24 7 18 V11 Z" fill="#6d4bc8" />
      <path d="M13 18 l3 3 l6 -6" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" />
      <text x="34" y="22" class="art-s" style="font-weight:700">{L.mine}</text>
    </g>
  </g>
  <path d="M372 200 C340 220 380 240 366 256" stroke="#d9480f" stroke-width="2" stroke-dasharray="4 5" fill="none" />
</svg>

<style>
  .hero-art { width: 100%; max-width: 520px; height: auto; justify-self: center;
    --art-sky1: #fde8d7; --art-sky2: #f6f1ea; --art-mount: #c9d3e0; --art-snow: #ffffff; --art-ground: #e9dcc9;
    --art-steel: #33415c; --art-frame: #6b7a90; --art-panel: #9cb4d8; --art-jeans: #33415c; }
  @media (prefers-color-scheme: dark) {
    .hero-art { --art-sky1: #2a1d15; --art-sky2: #18202a; --art-mount: #2c3a4d; --art-snow: #c9d3e0; --art-ground: #2a2722;
      --art-steel: #9fb0c8; --art-frame: #7d8da5; --art-panel: #34507a; --art-jeans: #55678a; }
  }
  .art-h { font: 700 15px var(--serif); fill: var(--ink); }
  .art-s { font: 600 11px var(--sans); fill: var(--muted); }
  @media (prefers-reduced-motion: no-preference) {
    .waves path { animation: pulse 2.4s ease-in-out infinite; }
    .waves path:nth-child(2) { animation-delay: 0.4s; }
    @keyframes pulse { 0%, 100% { opacity: 0.25; } 50% { opacity: 1; } }
  }
</style>
