---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { t, langs, type Lang } from '../../../i18n/ui';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const endYear = (e: number | 'present') => (e === 'present' ? 9999 : e);
const projects = (await getCollection('projects')).sort(
  (a, b) => endYear(b.data.end) - endYear(a.data.end) || b.data.start - a.data.start,
);
const epm = projects.filter((p) => p.data.topics.includes('epm'));
const rest = projects.filter((p) => !p.data.topics.includes('epm'));
---
<Base lang={lang} title={t(lang, 'projects.title')} route="projects/" active="projects">
  <section class="section">
    <div class="wrap">
      <h1>{t(lang, 'projects.title')}</h1>
      <p class="lead">{t(lang, 'projects.lead')}</p>
      <h2 style="margin-top:2.5rem">{t(lang, 'topic.epm')}</h2>
      <div class="grid">{epm.map((p) => <ProjectCard project={p} lang={lang} />)}</div>
      <h2 style="margin-top:3rem">{lang === 'es' ? 'Transformación digital de la construcción' : 'Digital transformation of construction'}</h2>
      <div class="grid">{rest.map((p) => <ProjectCard project={p} lang={lang} />)}</div>
    </div>
  </section>
</Base>
