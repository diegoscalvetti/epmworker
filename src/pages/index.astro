---
// Root: send visitors to their language. Spanish is the default for the Chilean audience.
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>EPM Worker · Diego Calvetti</title>
    <link rel="canonical" href="https://epmworker.com/es/" />
    <link rel="alternate" hreflang="es-CL" href="https://epmworker.com/es/" />
    <link rel="alternate" hreflang="en-GB" href="https://epmworker.com/en/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      var l = (navigator.languages || [navigator.language || 'es']).join(',').toLowerCase();
      var es = l.indexOf('es') !== -1 && (l.indexOf('en') === -1 || l.indexOf('es') < l.indexOf('en'));
      location.replace(es || l.indexOf('en') === -1 ? '/es/' : '/en/');
    </script>
    <meta http-equiv="refresh" content="1; url=/es/" />
  </head>
  <body style="font-family:system-ui,sans-serif;padding:2rem">
    <p><a href="/es/">Español</a> · <a href="/en/">English</a></p>
  </body>
</html>
